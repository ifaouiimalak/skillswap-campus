{% extends 'base.html.twig' %}

{% block title %}Inscription — SkillSwap Campus{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <h1 class="h3 mb-3 fw-bold text-primary">Créer un compte</h1>
                {{ form_start(registrationForm) }}
                    {{ form_widget(registrationForm) }}
                    <button type="submit" class="btn btn-primary w-100 mt-2">S'inscrire</button>
                {{ form_end(registrationForm) }}
                <p class="mt-3 text-center small">
                    Déjà inscrit ? <a href="{{ path('app_login') }}">Se connecter</a>
                </p>
            </div>
        </div>
    </div>
</div>
{% endblock %}
