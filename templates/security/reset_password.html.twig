{% extends 'base.html.twig' %}

{% block title %}Nouveau mot de passe — SkillSwap Campus{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <h1 class="h4 mb-3 fw-bold">Définir un nouveau mot de passe</h1>
                {{ form_start(form) }}
                    {{ form_widget(form) }}
                    <button type="submit" class="btn btn-success w-100 mt-2">Enregistrer</button>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}
