{% extends 'base.html.twig' %}

{% block title %}Connexion — SkillSwap Campus{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <h1 class="h3 mb-3 fw-bold text-primary">Connexion</h1>

                {% if error %}
                    <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                {% endif %}

                <form method="post" action="{{ path('app_login') }}">
                    <div class="mb-3">
                        <label for="inputEmail" class="form-label">Email</label>
                        <input type="email" value="{{ last_username }}" name="_username" id="inputEmail" class="form-control" required autofocus>
                    </div>
                    <div class="mb-3">
                        <label for="inputPassword" class="form-label">Mot de passe</label>
                        <input type="password" name="_password" id="inputPassword" class="form-control" required>
                    </div>
                    <div class="form-check mb-3">
                        <input type="checkbox" name="_remember_me" id="rememberMe" class="form-check-input">
                        <label for="rememberMe" class="form-check-label">Se souvenir de moi</label>
                    </div>
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                    <button class="btn btn-primary w-100" type="submit">Se connecter</button>
                </form>

                <div class="mt-3 d-flex justify-content-between small">
                    <a href="{{ path('app_forgot_password') }}">Mot de passe oublié ?</a>
                    <a href="{{ path('app_register') }}">Créer un compte</a>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
