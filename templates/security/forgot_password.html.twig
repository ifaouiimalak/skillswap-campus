{% extends 'base.html.twig' %}

{% block title %}Mot de passe oublié — SkillSwap Campus{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <h1 class="h4 mb-3 fw-bold">Réinitialiser le mot de passe</h1>
                {{ form_start(form) }}
                    {{ form_widget(form) }}
                    <button type="submit" class="btn btn-primary w-100 mt-2">Générer le lien</button>
                {{ form_end(form) }}

                {% if simulatedLink %}
                    <div class="alert alert-warning mt-3">
                        <strong>Email simulé :</strong>
                        <a href="{{ simulatedLink }}">Cliquez ici pour réinitialiser votre mot de passe</a>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %}
