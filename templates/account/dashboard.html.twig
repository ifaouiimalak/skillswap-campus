{% extends 'base.html.twig' %}

{% block title %}Mon Espace — SkillSwap Campus{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 fw-bold mb-0">Bonjour, {{ user.fullName }}</h1>
        <small class="text-muted">Niveau : {{ user.level|capitalize }} · Langue : {{ user.language }}</small>
    </div>
    <div>
        <a href="{{ path('app_account_profile') }}" class="btn btn-outline-primary btn-sm">Modifier mon profil</a>
        <a href="{{ path('app_account_messages') }}" class="btn btn-primary btn-sm">Messagerie</a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted small">Crédits-temps disponibles</div>
                <div class="display-6 fw-bold text-primary">{{ user.wallet ? user.wallet.timeCredits : 0 }} h</div>
                <a href="{{ path('app_wallet_index') }}" class="small">Voir mon portefeuille →</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted small">Réservations récentes</div>
                <div class="display-6 fw-bold text-success">{{ user.bookings|length }}</div>
                <a href="{{ path('app_booking_index') }}" class="small">Historique des commandes →</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted small">Badges obtenus</div>
                <div class="display-6 fw-bold text-warning">{{ user.badges|length }}</div>
                <span class="small text-muted">Gamification & certificats</span>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white fw-bold">Dernières réservations</div>
            <div class="card-body p-0">
                {% if bookings is empty %}
                    <p class="p-3 text-muted mb-0">Aucune réservation pour le moment. <a href="{{ path('app_catalogue') }}">Explorer le catalogue</a>.</p>
                {% else %}
                    <table class="table table-hover mb-0">
                        <thead><tr><th>Offre</th><th>Statut</th><th>Coût</th><th></th></tr></thead>
                        <tbody>
                        {% for b in bookings %}
                            <tr>
                                <td>{{ b.offer.title }}</td>
                                <td><span class="badge bg-info text-dark">{{ b.status }}</span></td>
                                <td>{{ b.totalCredits }} h / {{ b.totalEur }} €</td>
                                <td><a href="{{ path('app_booking_show', {id: b.id}) }}" class="btn btn-sm btn-outline-secondary">Détails</a></td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                {% endif %}
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white fw-bold">Mes Badges</div>
            <div class="card-body">
                {% if user.badges is empty %}
                    <p class="text-muted small mb-0">Terminez des sessions pour débloquer vos premiers badges !</p>
                {% else %}
                    {% for badge in user.badges %}
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="badge bg-warning text-dark">{{ badge.icon }} {{ badge.name }}</span>
                            <a href="{{ path('app_badge_certificate', {id: badge.id}) }}" class="small">Certificat</a>
                        </div>
                    {% endfor %}
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %}
