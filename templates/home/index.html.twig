{% extends 'base.html.twig' %}

{% block title %}SkillSwap Campus — Accueil{% endblock %}

{% block body %}
<div class="p-5 mb-4 bg-white rounded-3 shadow-sm border">
    <div class="container-fluid py-3">
        <h1 class="display-5 fw-bold text-primary">SkillSwap Campus</h1>
        <p class="col-md-8 fs-5 text-secondary">
            Marketplace d'échange de compétences où étudiants et jeunes professionnels réservent des sessions de mentorat
            ou partagent leurs savoir-faire grâce au système de crédits-temps (1h enseignée = 1h réservée).
        </p>
        <span class="badge bg-success">Symfony 7 — Socle initial (v0.1-base)</span>
    </div>
</div>
{% endblock %}
